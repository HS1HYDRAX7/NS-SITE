      el.style.height = '0';
    }

    field.appendChild(el);
  }
})();

document.querySelectorAll('.toggle-download').forEach(function(btn){
  btn.addEventListener('click', function(){
    var platform = btn.getAttribute('data-platform');
    var gameBody = btn.closest('.game-body');
    var panel = gameBody.querySelector('.download-panel[data-platform="' + platform + '"]');
    if (!panel) return;

    var wasOpen = panel.classList.contains('open');

    // Accordion: only one platform panel open per card at a time.
    // Opening Android closes Windows (and vice-versa) automatically.
    gameBody.querySelectorAll('.download-panel').forEach(function(p){
      p.classList.remove('open');
    });
    gameBody.querySelectorAll('.toggle-download').forEach(function(b){
      b.setAttribute('aria-expanded', 'false');
    });

    if (!wasOpen){
      panel.classList.add('open');
      btn.setAttribute('aria-expanded', 'true');
    }
  });
});

document.querySelectorAll('.toggle-versions').forEach(function(btn){
  btn.addEventListener('click', function(){
    var list = btn.closest('.download-panel').querySelector('.versions-list');
    var isOpen = list.classList.toggle('open');
    btn.setAttribute('aria-expanded', isOpen);
    btn.textContent = isOpen ? 'Hide versions' : 'Older versions';
  });
});

