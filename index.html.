/* ---------- Brand-word easter egg ---------- */
(function(){
  var brandWord = document.querySelector('.brand-word');
  if (!brandWord) return;

  var ORIGINAL_TEXT = brandWord.textContent;
  var EASTER_TEXT = 'Harley';
  var SCRAMBLE_CHARS = 'ABCDEFGHIJKLMNOPQRSTUVWXYZ!@#$%&*';
  var CLICKS_NEEDED = 5;
  var CLICK_WINDOW_MS = 2000;
  var HOLD_MS = 5000;

  var clickCount = 0;
  var clickTimer = null;
  var isAnimating = false;

  var heartsContainer = document.querySelector('.hearts-burst');
  var harleyAudio = new Audio('https://raw.githubusercontent.com/HS1HYDRAX7/NS-SITE/main/assets/audio/doors-lotus-revive-sound_ZJ0phM7.mp3');
  harleyAudio.preload = 'auto';

  function playHarleySound(){
    try{
      harleyAudio.currentTime = 0;
      harleyAudio.play().catch(function(){});
    }catch(e){}
  }

  function spawnHeart(){
    if (!heartsContainer) return;
    var heart = document.createElement('span');
    heart.className = 'heart-particle';
    heart.textContent = '\u2764\ufe0f';
    heart.style.left = (Math.random() * 90) + '%';
    heart.style.fontSize = (14 + Math.random() * 16) + 'px';
    var duration = 1100 + Math.random() * 900;
    heart.style.animationDuration = duration + 'ms';
    heart.style.setProperty('--drift', (Math.random() * 70 - 35) + 'px');
    heart.style.setProperty('--rot', (Math.random() * 40 - 20) + 'deg');
    heartsContainer.appendChild(heart);
    setTimeout(function(){ heart.remove(); }, duration + 80);
  }

  function startHeartsBurst(){
    for (var i = 0; i < 9; i++){
      setTimeout(spawnHeart, i * 40);
    }
    return setInterval(spawnHeart, 260);
  }

  function scrambleTo(el, fromText, toText, onDone){
    var length = Math.max(fromText.length, toText.length);
    var totalFrames = 26;
    var frame = 0;
    var framesPerChar = totalFrames / length;

    el.classList.add('is-scrambling');

    var interval = setInterval(function(){
      var output = '';
      for (var i = 0; i < length; i++){
        var lockFrame = (i + 1) * framesPerChar * 0.85;
        if (frame >= lockFrame){
          output += toText[i] || '';
        } else {
          output += SCRAMBLE_CHARS[Math.floor(Math.random() * SCRAMBLE_CHARS.length)];
        }
      }
      el.textContent = output;
      frame++;
      if (frame > totalFrames){
        clearInterval(interval);
        el.textContent = toText;
        el.classList.remove('is-scrambling');
        if (onDone) onDone();
      }
    }, 45);
  }

  brandWord.addEventListener('click', function(){
    if (isAnimating) return;

    clickCount++;
    clearTimeout(clickTimer);
    clickTimer = setTimeout(function(){ clickCount = 0; }, CLICK_WINDOW_MS);

    if (clickCount >= CLICKS_NEEDED){
      clickCount = 0;
      clearTimeout(clickTimer);
      isAnimating = true;

      scrambleTo(brandWord, ORIGINAL_TEXT, EASTER_TEXT, function(){
        playHarleySound();
        var heartsInterval = startHeartsBurst();
        setTimeout(function(){
          clearInterval(heartsInterval);
          scrambleTo(brandWord, EASTER_TEXT, ORIGINAL_TEXT, function(){
            isAnimating = false;
          });
        }, HOLD_MS);
      });
    }
  });
})();
</script>

