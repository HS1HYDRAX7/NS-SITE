<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover">
<title>Nemesis Studios</title>
<meta name="description" content="Nemesis Studios — independent game development studio.">
<meta name="theme-color" content="#0c1522">
<meta property="og:title" content="Nemesis Studios">
<meta property="og:description" content="Independent game development studio crafting inspired and original titles.">
<meta property="og:type" content="website">
<meta property="og:image" content="https://raw.githubusercontent.com/HS1HYDRAX7/NS-SITE/main/assets/images/logo/NS%20icon.png">
<meta name="twitter:card" content="summary_large_image">
<link rel="icon" href="https://raw.githubusercontent.com/HS1HYDRAX7/NS-SITE/main/assets/images/logo/NS%20icon.png">
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Rajdhani:wght@500;600;700&family=Manrope:wght@400;500;600;700;800&display=swap" rel="stylesheet">
<style>

@font-face{
  font-family:'StretchPro';
  src:url('https://raw.githubusercontent.com/HS1HYDRAX7/NS-SITE/main/assets/fonts/StretchPro.ttf') format('truetype');
  font-weight:normal;
  font-style:normal;
  font-display:swap;
}
@font-face{
  font-family:'Plakativ';
  src:url('https://raw.githubusercontent.com/HS1HYDRAX7/NS-SITE/main/assets/fonts/plakativ.ttf') format('truetype');
  font-weight:normal;
  font-style:normal;
  font-display:swap;
}
@font-face{
  font-family:'Russian Dollmaker';
  src:url('https://raw.githubusercontent.com/HS1HYDRAX7/NS-SITE/main/assets/fonts/Russian%20Dollmaker.ttf') format('truetype');
  font-weight:normal;
  font-style:normal;
  font-display:swap;
}

:root{
  --red-1:#ff3b3f;
  --red-2:#ff6a4d;
  --red-3:#c40f2e;
  --red-glow: 255,59,63;
  --glass-fill: rgba(255,255,255,0.08);
  --glass-fill-strong: rgba(255,255,255,0.14);
  --glass-border: rgba(255,255,255,0.35);
  --glass-sheen: rgba(255,255,255,0.55);
  --bg-1:#050810;
  --bg-2:#0c1522;
  --bg-3:#160a12;
  --text-1:#f3f6fb;
  --text-2:#b9c4d4;
  --shadow-deep: 0 20px 60px rgba(0,0,0,0.45);

  --state-stable:#33d17a;
  --state-unstable:#ff3b3f;
  --state-build:#3aa7ff;
  --state-updating:#ffcc33;

  --android-1:#3ddc84;
  --android-2:#0f9d58;
  --windows-1:#4fb3ff;
  --windows-2:#0d6efd;
}

@media (prefers-color-scheme: light){
  :root{
    --glass-fill: rgba(255,255,255,0.45);
    --glass-fill-strong: rgba(255,255,255,0.65);
    --glass-border: rgba(255,255,255,0.7);
    --glass-sheen: rgba(255,255,255,0.85);
    --bg-1:#eaf1fb;
    --bg-2:#fdf1f0;
    --bg-3:#f5e6ea;
    --text-1:#1a1420;
    --text-2:#5a5560;
    --shadow-deep: 0 20px 50px rgba(150,40,50,0.12);
  }
}

*{box-sizing:border-box;}
html,body{margin:0;padding:0;}
body{
  font-family:'Manrope', sans-serif;
  background:
    radial-gradient(1200px 700px at 85% -10%, rgba(var(--red-glow),0.25), transparent 60%),
    radial-gradient(900px 600px at 10% 110%, rgba(58,167,255,0.10), transparent 60%),
    linear-gradient(160deg, var(--bg-1), var(--bg-2) 45%, var(--bg-3));
  color:var(--text-1);
  min-height:100vh;
  overflow-x:hidden;
  position:relative;
  transition:background 0.6s ease, color 0.6s ease;
}

h1,h2,h3,.brand-word{
  font-family:'Rajdhani', 'Manrope', sans-serif;
  font-weight:700;
  letter-spacing:0.01em;
}

.brand-word{
  font-family:'Russian Dollmaker', 'Rajdhani', sans-serif;
  font-size:40px;
  letter-spacing:0.08em;
  font-weight:normal;
}

.hero-copy h1{
  font-family:'Plakativ', 'Rajdhani', sans-serif;
}

::selection{background:rgba(var(--red-glow),0.35);}

#shapes-field{
  position:fixed;
  inset:0;
  overflow:hidden;
  z-index:0;
  pointer-events:none;
}
.shape{
  position:absolute;
  top:-140px;
  opacity:0.5;
  background:linear-gradient(135deg, rgba(var(--red-glow),0.35), rgba(255,255,255,0.06));
  border:1px solid rgba(255,255,255,0.25);
  backdrop-filter:blur(2px);
  animation-name:fall;
  animation-timing-function:linear;
  animation-iteration-count:infinite;
}
.shape.circle{border-radius:50%;}
.shape.rrect{border-radius:22%;}
.shape.square{border-radius:18%;}
.shape.tri{
  background:none;
  border:none;
  width:0;
  height:0;
  opacity:0.4;
}
.shape.tri::before{
  content:'';
  position:absolute;
  inset:0;
  clip-path:polygon(50% 0%, 100% 100%, 0% 100%);
  background:linear-gradient(160deg, rgba(var(--red-glow),0.4), rgba(255,255,255,0.08));
  border-radius:14%;
}

@keyframes fall{
  0%{transform:translateY(-10vh) translateX(0) rotate(0deg);}
  100%{transform:translateY(115vh) translateX(var(--drift,40px)) rotate(360deg);}
}

@media (prefers-reduced-motion: reduce){
  .shape{animation:none; display:none;}
}

.container{
  max-width:1280px;
  margin:0 auto;
  padding:0 32px;
  position:relative;
  z-index:2;
}

.glass{
  background:var(--glass-fill);
  border:1px solid var(--glass-border);
  border-radius:26px;
  backdrop-filter:blur(22px) saturate(160%);
  -webkit-backdrop-filter:blur(22px) saturate(160%);
  box-shadow:var(--shadow-deep), inset 0 1px 0 var(--glass-sheen), inset 0 0 40px rgba(255,255,255,0.03);
  position:relative;
}
.glass::after{
  content:'';
  position:absolute;
  top:0;left:0;right:0;
  height:45%;
  border-radius:26px 26px 60% 60% / 26px 26px 100% 100%;
  background:linear-gradient(180deg, rgba(255,255,255,0.16), rgba(255,255,255,0));
  pointer-events:none;
}

header{
  position:sticky;
  top:0;
  z-index:50;
  padding:18px 0;
}
.nav-glass{
  display:flex;
  align-items:center;
  justify-content:space-between;
  padding:12px 24px;
  border-radius:20px;
}
.brand{
  display:flex;
  align-items:center;
  gap:12px;
  font-size:20px;
  position:relative;
}
.brand img{
  width:40px;
  height:40px;
  border-radius:12px;
  object-fit:cover;
  box-shadow:0 4px 14px rgba(var(--red-glow),0.4);
}
nav ul{
  list-style:none;
  display:flex;
  gap:28px;
  margin:0;
  padding:0;
}
nav a{
  color:var(--text-2);
  text-decoration:none;
  font-weight:600;
  font-size:15px;
  transition:color 0.25s ease;
}
nav a:hover, nav a:focus-visible{color:var(--red-1);}

.hero{
  padding:120px 0 80px;
  display:flex;
  align-items:center;
  gap:56px;
  min-height:80vh;
}

.hero-logo-wrap{
  flex:0 0 auto;
  display:flex;
  justify-content:flex-end;
  align-items:center;
  width:320px;
  max-width:38vw;
}
.hero-logo-glass{
  padding:22px;
  border-radius:34px;
  animation:float-logo 7s ease-in-out infinite;
}
.hero-logo-glass img{
  width:100%;
  aspect-ratio:1/1;
  object-fit:contain;
  display:block;
  filter:drop-shadow(0 10px 30px rgba(var(--red-glow),0.5));
}
@keyframes float-logo{
  0%,100%{transform:translateY(0px);}
  50%{transform:translateY(-14px);}
}

.btn{
  display:inline-flex;
  align-items:center;
  gap:10px;
  padding:14px 28px;
  border-radius:16px;
  font-weight:700;
  font-size:15px;
  text-decoration:none;
  border:1px solid var(--glass-border);
  cursor:pointer;
  transition:transform 0.2s ease, box-shadow 0.2s ease, background 0.2s ease;
}
.btn-primary{
  background:linear-gradient(135deg, var(--red-1), var(--red-3));
  color:#fff;
  box-shadow:0 10px 30px rgba(var(--red-glow),0.45), inset 0 1px 0 rgba(255,255,255,0.4);
}
.btn-primary:hover{transform:translateY(-3px); box-shadow:0 16px 36px rgba(var(--red-glow),0.55), inset 0 1px 0 rgba(255,255,255,0.5);}
.btn-ghost{
  background:var(--glass-fill);
  color:var(--text-1);
  backdrop-filter:blur(14px);
}
.btn-ghost:hover{transform:translateY(-3px); background:var(--glass-fill-strong);}
.btn-android{
  background:linear-gradient(135deg, var(--android-1), var(--android-2));
  color:#fff;
  box-shadow:0 10px 30px rgba(15,157,88,0.45), inset 0 1px 0 rgba(255,255,255,0.4);
}
.btn-android:hover{transform:translateY(-3px); box-shadow:0 16px 36px rgba(15,157,88,0.55), inset 0 1px 0 rgba(255,255,255,0.5);}
.btn-windows{
  background:linear-gradient(135deg, var(--windows-1), var(--windows-2));
  color:#fff;
  box-shadow:0 10px 30px rgba(13,110,253,0.45), inset 0 1px 0 rgba(255,255,255,0.4);
}
.btn-windows:hover{transform:translateY(-3px); box-shadow:0 16px 36px rgba(13,110,253,0.55), inset 0 1px 0 rgba(255,255,255,0.5);}
.btn svg{flex:0 0 auto; display:block;}
.btn-icon{width:18px; height:18px; object-fit:contain; flex:0 0 auto; display:block;}
.btn:active{transform:translateY(0);}
.btn:focus-visible{outline:2px solid var(--red-1); outline-offset:3px;}

section{padding:70px 0;}
.section-head{margin-bottom:40px; max-width:640px;}
.section-head h2{font-size:clamp(28px,4vw,42px); margin:0 0 12px; font-family:'Plakativ', 'Rajdhani', sans-serif;}
.section-head p{color:var(--text-2); font-size:16px; line-height:1.6; margin:0;}

#games-grid{
  display:grid;
  grid-template-columns:repeat(auto-fit, minmax(300px, 1fr));
  gap:28px;
}
.game-card{
  border-radius:26px;
  overflow:hidden;
  display:flex;
  flex-direction:column;
  transition:transform 0.35s ease, box-shadow 0.35s ease;
}
.game-card:hover{transform:translateY(-8px);}
.game-cover{
  width:100%;
  aspect-ratio:16/9;
  object-fit:cover;
  display:block;
  border-bottom:1px solid var(--glass-border);
}
.game-body{padding:22px 24px 26px; display:flex; flex-direction:column; gap:14px; flex:1;}
.game-body h3{margin:0; font-size:22px; font-family:'StretchPro', 'Rajdhani', sans-serif;}
.game-body p{margin:0; color:var(--text-2); font-size:14.5px; line-height:1.55; flex:1;}

.status-row{
  display:flex;
  align-items:center;
  gap:10px;
  flex-wrap:wrap;
}
.pill{
  display:inline-flex;
  align-items:center;
  gap:8px;
  padding:6px 14px;
  border-radius:999px;
  font-size:13px;
  font-weight:700;
  border:1px solid rgba(255,255,255,0.25);
  background:rgba(255,255,255,0.08);
}
.pill .dot{
  width:9px;
  height:9px;
  border-radius:50%;
  box-shadow:0 0 10px currentColor;
  animation:pulse-dot 1.8s ease-in-out infinite;
}
@keyframes pulse-dot{
  0%,100%{opacity:1;}
  50%{opacity:0.4;}
}
.pill.stable{color:var(--state-stable);}
.pill.unstable{color:var(--state-unstable);}
.pill.build{color:var(--state-build);}
.pill.updating{color:var(--state-updating);}
.version-tag{
  font-family:'StretchPro', 'Rajdhani', sans-serif;
  font-weight:700;
  font-size:14px;
  color:var(--text-1);
  opacity:0.85;
}

.game-actions{display:flex; gap:10px; flex-wrap:wrap; margin-top:6px;}
.game-actions .btn{padding:10px 18px; font-size:13.5px;}

.download-panel{
  display:none;
  flex-direction:column;
  gap:14px;
  padding:20px 24px;
  border-top:1px solid var(--glass-border);
  animation:reveal 0.4s ease;
}
.download-panel.open{display:flex;}
@keyframes reveal{
  from{opacity:0; transform:translateY(-8px);}
  to{opacity:1; transform:translateY(0);}
}
.download-panel .row{display:flex; gap:10px; flex-wrap:wrap;}
.versions-list{
  display:none;
  flex-direction:column;
  gap:8px;
  max-height:220px;
  overflow-y:auto;
  padding-right:4px;
}
.versions-list.open{display:flex;}
.version-item{
  display:flex;
  align-items:center;
  justify-content:space-between;
  gap:10px;
  padding:10px 14px;
  border-radius:14px;
  background:rgba(255,255,255,0.06);
  border:1px solid rgba(255,255,255,0.15);
  font-size:13.5px;
}
.version-item a{color:var(--red-2); text-decoration:none; font-weight:700;}
.version-item a:hover{text-decoration:underline;}

.add-game-slot{
  border-radius:26px;
  border:2px dashed rgba(255,255,255,0.25);
  display:flex;
  align-items:center;
  justify-content:center;
  min-height:220px;
  color:var(--text-2);
  font-size:14px;
  text-align:center;
  padding:24px;
}

#devs-grid{
  display:grid;
  grid-template-columns:repeat(auto-fit, minmax(240px, 1fr));
  gap:28px;
}
.dev-card{
  border-radius:26px;
  padding:30px 24px;
  display:flex;
  flex-direction:column;
  align-items:center;
  text-align:center;
  gap:6px;
  transition:transform 0.35s ease, box-shadow 0.35s ease;
}
.dev-card:hover{transform:translateY(-8px);}
.dev-avatar{
  width:96px;
  height:96px;
  border-radius:50%;
  object-fit:cover;
  margin-bottom:10px;
  border:2px solid rgba(var(--red-glow),0.5);
  box-shadow:0 8px 24px rgba(var(--red-glow),0.35);
}
.dev-body h3{margin:0; font-size:20px; font-family:'StretchPro', 'Rajdhani', sans-serif;}
.dev-role{
  font-size:12px;
  font-weight:700;
  letter-spacing:0.06em;
  text-transform:uppercase;
  color:var(--red-2);
}
.dev-body p{margin:8px 0 0; color:var(--text-2); font-size:14px; line-height:1.55;}
.add-dev-slot{
  border-radius:26px;
  border:2px dashed rgba(255,255,255,0.25);
  display:flex;
  align-items:center;
  justify-content:center;
  min-height:220px;
  color:var(--text-2);
  font-size:14px;
  text-align:center;
  padding:24px;
}
.footer-credit{
  margin-top:6px;
  font-size:12px;
  opacity:0.7;
}
.footer-credit a{color:var(--red-2); text-decoration:none;}
.footer-credit a:hover{text-decoration:underline;}

.support-section .glass{
  padding:48px;
  display:flex;
  align-items:center;
  justify-content:space-between;
  gap:32px;
  flex-wrap:wrap;
}
.support-copy h2{margin:0 0 10px; font-size:clamp(26px,3.6vw,36px); font-family:'Plakativ', 'Rajdhani', sans-serif;}
.support-copy p{margin:0; color:var(--text-2); max-width:460px; line-height:1.6;}

footer{
  padding:40px 0 60px;
  text-align:center;
  color:var(--text-2);
  font-size:13.5px;
}

@media (min-width:1600px){
  .container{max-width:1520px;}
  .hero{min-height:70vh;}
}

@media (max-width:900px){
  .hero{flex-direction:column; text-align:center; padding-top:150px;}
  .hero-copy p{margin-left:auto; margin-right:auto;}
  .hero-logo-wrap{width:220px; max-width:60vw; justify-content:center;}
  nav ul{gap:16px;}
  .support-section .glass{flex-direction:column; text-align:center;}
}

@media (max-width:600px){
  .container{padding:0 18px;}
  nav ul{display:none;}
  .hero{padding-top:130px;}
  .hero-copy h1{font-size:38px;}
  section{padding:50px 0;}
}

.dl-hero{
  position:relative;
  isolation:isolate;
  min-height:150px;
  border-radius:18px;
  display:flex;
  flex-direction:column;
  align-items:center;
  justify-content:center;
  overflow:hidden;
  border:1px solid rgba(255,255,255,0.18);
}
.dl-hero::before{
  content:'';
  position:absolute;
  inset:0;
  z-index:-1;
}
.dl-hero--android::before{background:radial-gradient(140% 130% at 50% -10%, var(--android-1), rgba(6,20,14,0.94) 68%);}
.dl-hero--windows::before{background:radial-gradient(140% 130% at 50% -10%, var(--windows-1), rgba(6,14,26,0.94) 68%);}
.dl-hero-badge{
  position:absolute;
  top:12px; left:12px;
  font-family:'Rajdhani', sans-serif;
  font-size:12px;
  font-weight:700;
  letter-spacing:0.04em;
  padding:5px 12px;
  border-radius:999px;
  background:rgba(0,0,0,0.4);
  color:#fff;
  border:1px solid rgba(255,255,255,0.28);
}
.dl-hero-size{
  position:absolute;
  bottom:12px; left:12px;
  font-family:'Rajdhani', sans-serif;
  font-size:12.5px;
  font-weight:700;
  color:#fff;
  padding:4px 11px;
  border-radius:999px;
  background:rgba(0,0,0,0.4);
  border:1px solid rgba(255,255,255,0.22);
}
.dl-hero-icon{
  width:58px; height:58px;
  border-radius:16px;
  display:flex; align-items:center; justify-content:center;
  background:rgba(255,255,255,0.14);
  border:1px solid rgba(255,255,255,0.32);
  color:#fff;
  box-shadow:0 8px 22px rgba(0,0,0,0.3);
}
.dl-hero-icon svg{width:26px; height:26px;}

.dl-file-row{
  display:flex;
  align-items:center;
  justify-content:space-between;
  gap:14px;
  padding:16px 2px 4px;
  flex-wrap:wrap;
}
.dl-file-name{display:flex; flex-direction:column; gap:2px; min-width:0;}
.dl-file-name strong{font-size:15px; font-family:'StretchPro', 'Rajdhani', sans-serif;}
.dl-file-name span{color:var(--text-2); font-size:12.5px;}
.dl-download-btn{
  display:inline-flex;
  align-items:center;
  gap:8px;
  flex:0 0 auto;
  padding:12px 22px;
  border-radius:999px;
  background:#fff;
  color:#14151d;
  font-weight:700;
  font-size:14px;
  text-decoration:none;
  border:1px solid rgba(255,255,255,0.7);
  box-shadow:0 10px 24px rgba(0,0,0,0.28);
  transition:transform 0.2s ease, box-shadow 0.2s ease;
}
.dl-download-btn svg{width:16px; height:16px;}
.dl-download-btn:hover{transform:translateY(-2px); box-shadow:0 14px 30px rgba(0,0,0,0.34);}
.dl-download-btn:focus-visible{outline:2px solid #fff; outline-offset:3px;}

.dl-older-toggle{
  align-self:flex-start;
  margin:2px 2px 0;
  background:none;
  border:none;
  padding:2px 0;
  color:var(--text-2);
  font-size:12.5px;
  font-weight:700;
  text-decoration:underline;
  text-underline-offset:3px;
  cursor:pointer;
}
.dl-older-toggle:hover{color:var(--text-1);}
.dl-older-toggle:focus-visible{outline:2px solid var(--red-1); outline-offset:3px;}

@media (max-width:420px){
  .dl-file-row{flex-direction:column; align-items:stretch;}
  .dl-download-btn{justify-content:center;}
}

/* ---------- Loading screen ---------- */
#loading-screen{
  position:fixed;
  inset:0;
  z-index:9999;
  display:flex;
  align-items:center;
  justify-content:center;
  background:
    radial-gradient(1000px 600px at 50% 30%, rgba(var(--red-glow),0.18), transparent 60%),
    linear-gradient(160deg, var(--bg-1), var(--bg-2) 45%, var(--bg-3));
  transition:opacity 0.7s ease;
}
#loading-screen.is-hidden{
  opacity:0;
  pointer-events:none;
}
.loading-inner{
  display:flex;
  flex-direction:column;
  align-items:center;
  gap:26px;
}
.loading-ring{
  position:relative;
  width:96px;
  height:96px;
  display:flex;
  align-items:center;
  justify-content:center;
}
.loading-ring::before{
  content:'';
  position:absolute;
  inset:0;
  border-radius:50%;
  border:3px solid rgba(255,255,255,0.12);
  border-top-color:var(--red-1);
  border-right-color:var(--red-2);
  animation:loading-spin 1s linear infinite;
}
.loading-ring img{
  width:56px;
  height:56px;
  object-fit:contain;
  border-radius:14px;
  filter:drop-shadow(0 6px 18px rgba(var(--red-glow),0.5));
}
@keyframes loading-spin{
  to{transform:rotate(360deg);}
}
.loading-bar{
  width:200px;
  height:4px;
  border-radius:999px;
  background:rgba(255,255,255,0.12);
  overflow:hidden;
}
.loading-bar-fill{
  height:100%;
  width:100%;
  transform-origin:left center;
  transform:scaleX(0);
  background:linear-gradient(90deg, var(--red-2), var(--red-1));
  transition:transform linear;
}
.loading-text{
  font-family:'Rajdhani', 'Manrope', sans-serif;
  font-weight:600;
